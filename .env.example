# ==============================================================================
# CoreBot - Environment Configuration Example
# ==============================================================================

# Node Environment: 'development', 'test', 'production'
NODE_ENV=development

# Discord Bot Credentials
# Obtain token from Discord Developer Portal (https://discord.com/developers/applications)
BOT_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here

# Access Control: Comma-separated list of Guild (Server) IDs where the bot is allowed to operate.
# The bot will strictly ignore commands, events, and interactions outside these guilds.
DISCORD_ALLOWED_GUILD_IDS=123456789012345678

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?connection_limit=25&pool_timeout=20
DATABASE_URL=postgresql://corebot:corebot@postgres:5432/corebot?connection_limit=25&pool_timeout=20

# Redis Connection (Used for BullMQ scheduled jobs: Agenda, Birthdays, Game Server Monitor)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Logging level: 'trace', 'debug', 'info', 'warn', 'error', 'fatal', 'silent'
LOG_LEVEL=info

# Default Guild Timezone (IANA Timezone string)
TIMEZONE=America/Sao_Paulo

# HTTP Server Port (Healthcheck, Fastify Bull-Board, Prometheus metrics, Webhooks)
PORT=3000

# Bull-Board Admin Dashboard Basic Auth Credentials (/admin/queues)
ADMIN_DASHBOARD_USER=admin
ADMIN_DASHBOARD_PASS=changeme

# Webhooks Secret Token (Validates X-Webhook-Token header)
WEBHOOK_SECRET=corebot-super-secure-webhook-secret

# Twitch Helix API Credentials (Used by stream-notifier module)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
