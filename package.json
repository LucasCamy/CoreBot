{
  "name": "corebot",
  "version": "1.0.0",
  "description": "CoreBot - Enterprise private Discord bot built with TypeScript, discord.js v14, Prisma, PostgreSQL and BullMQ",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "docker:dev": "docker compose -f docker-compose.yml up --build",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d --build"
  },
  "keywords": [
    "discord",
    "discord.js",
    "bot",
    "typescript",
    "prisma",
    "postgresql",
    "bullmq",
    "docker"
  ],
  "author": "CoreBot Team",
  "license": "MIT",
  "dependencies": {
    "@bull-board/api": "^9.10.4",
    "@bull-board/fastify": "^9.10.4",
    "@discordjs/voice": "^0.19.2",
    "@fastify/basic-auth": "^6.3.1",
    "@fastify/static": "^10.1.6",
    "@prisma/client": "^6.4.1",
    "bullmq": "^5.41.3",
    "dayjs": "^1.11.13",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.5",
    "ffmpeg-static": "^5.3.0",
    "ioredis": "^5.5.0",
    "opusscript": "^0.0.8",
    "pino": "^9.6.0",
    "prism-media": "^1.3.5",
    "prom-client": "^15.1.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/ffmpeg-static": "^3.0.3",
    "@types/node": "^22.13.5",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.1",
    "prisma": "^6.4.1",
    "tsc-alias": "^1.8.11",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
